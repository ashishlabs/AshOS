{
  "name": "ashos",
  "version": "0.1.0",
  "description": "AshOS - AI Operating System for Developers",
  "license": "MIT",
  "private": true,
  "main": "dist/sdk/ashos.js",
  "types": "dist/sdk/ashos.d.ts",
  "bin": {
    "ash": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "dashboard"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "cli": "tsx cli/index.ts",
    "api": "tsx api/server.ts",
    "dev": "tsx cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dashboard:dev": "npm run dev -w dashboard",
    "dashboard:build": "npm run build -w dashboard"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^2.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
