# Active provider: anthropic | openai | ollama | lmstudio | mock
ASHOS_PROVIDER=mock

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# LM Studio (local, OpenAI-compatible)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen/qwen2.5-coder-14b

# Innovation Intelligence: which provider/model reasons over discovered signals.
# Defaults to lmstudio/qwen2.5-coder-14b so it runs entirely on local hardware.
ASHOS_RESEARCH_PROVIDER=lmstudio
ASHOS_RESEARCH_MODEL=qwen/qwen2.5-coder-14b

# API server
ASHOS_API_PORT=4700
